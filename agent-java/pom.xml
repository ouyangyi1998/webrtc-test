<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>webrtc-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>webrtc-agent</name>
    <description>Java desktop agent for WebRTC control</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <webrtc.java.version>0.14.0</webrtc.java.version>
        <webrtc.java.classifier>macos-x86_64</webrtc.java.classifier>
        <javafx.version>17.0.9</javafx.version>
        <javafx.classifier>mac</javafx.classifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.5</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.12</version>
        </dependency>
        <!-- WebRTC native Java binding (desktop) - main library -->
        <dependency>
            <groupId>dev.onvoid.webrtc</groupId>
            <artifactId>webrtc-java</artifactId>
            <version>${webrtc.java.version}</version>
        </dependency>
        <!-- WebRTC native library for macOS (Apple Silicon) -->
        <dependency>
            <groupId>dev.onvoid.webrtc</groupId>
            <artifactId>webrtc-java</artifactId>
            <version>${webrtc.java.version}</version>
            <classifier>${webrtc.java.classifier}</classifier>
        </dependency>
        <!-- JavaFX dependencies: 需要无 classifier(类文件) + 有 classifier(原生库) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.example.agent.Launcher</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <!-- 排除无 classifier JavaFX 的原生库，只保留 Java 类 -->
                                <filter>
                                    <artifact>org.openjfx:javafx-graphics:jar:17.0.9</artifact>
                                    <excludes>
                                        <exclude>*.dylib</exclude>
                                        <exclude>*.so</exclude>
                                        <exclude>*.dll</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openjfx:javafx-controls:jar:17.0.9</artifact>
                                    <excludes>
                                        <exclude>*.dylib</exclude>
                                        <exclude>*.so</exclude>
                                        <exclude>*.dll</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openjfx:javafx-base:jar:17.0.9</artifact>
                                    <excludes>
                                        <exclude>*.dylib</exclude>
                                        <exclude>*.so</exclude>
                                        <exclude>*.dll</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openjfx:javafx-fxml:jar:17.0.9</artifact>
                                    <excludes>
                                        <exclude>*.dylib</exclude>
                                        <exclude>*.so</exclude>
                                        <exclude>*.dll</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.example.agent.javafx.AgentAppFX</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mac x86 本机开发 -->
        <profile>
            <id>mac-x86</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <webrtc.java.classifier>macos-x86_64</webrtc.java.classifier>
                <javafx.classifier>mac</javafx.classifier>
            </properties>
        </profile>
        
        <!-- Mac ARM64 测试设备 -->
        <profile>
            <id>mac-arm</id>
            <properties>
                <webrtc.java.classifier>macos-aarch64</webrtc.java.classifier>
                <javafx.classifier>mac-aarch64</javafx.classifier>
            </properties>
        </profile>
    </profiles>
</project>
