<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Remote Video Display -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Touch Overlay -->
    <com.example.remotecontrol.ui.remote.TouchOverlayView
        android:id="@+id/touchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Waiting Overlay -->
    <LinearLayout
        android:id="@+id/layoutWaiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/tvWaitingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/waiting_video"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Top Toolbar (Collapsible) -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Connection Status -->
        <View
            android:id="@+id/viewConnectionIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/status_indicator" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="已连接"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Keyboard Button -->
        <ImageButton
            android:id="@+id/btnKeyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="键盘"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/white" />

        <!-- Disconnect Button -->
        <ImageButton
            android:id="@+id/btnDisconnect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="断开连接"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Bottom Hint -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0.7"
        android:background="#40000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="单指点击=左键 | 长按=右键 | 双指滑动=滚轮 | 三指=工具栏"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
